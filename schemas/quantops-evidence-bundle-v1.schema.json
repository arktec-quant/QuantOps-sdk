{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arktec-quant.github.io/quantops-sdk/schemas/quantops-evidence-bundle-v1.schema.json",
  "title": "QuantOps Evidence Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "payload_sha256", "provenance", "payload"],
  "properties": {
    "schema_version": {"const": "quantops-evidence-bundle/v1"},
    "bundle_id": {"$ref": "#/$defs/token"},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "source_run_id", "generated_at", "inputs", "artifacts"],
      "properties": {
        "publisher": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_run_id": {"$ref": "#/$defs/token"},
        "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "inputs": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/input"}},
        "artifacts": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "tables", "notes"],
      "properties": {
        "summary": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/summary"}},
        "tables": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/table"}},
        "notes": {"type": "array", "maxItems": 24, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
      }
    }
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$"},
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "value": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "oneOf": [
      {"properties": {"kind": {"const": "text"}, "value": {"type": "string"}}},
      {"properties": {"kind": {"const": "number"}, "value": {"type": "number"}}},
      {"properties": {"kind": {"const": "boolean"}, "value": {"type": "boolean"}}}
    ]},
    "input": {"type": "object", "additionalProperties": false, "required": ["reference_id", "sha256"], "properties": {"reference_id": {"$ref": "#/$defs/token"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["label", "path", "sha256"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 512}, "path": {"type": "string", "pattern": "^artifacts/.+\\.(csv|json|pdf|txt)$"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["label", "value"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 512}, "value": {"$ref": "#/$defs/value"}}},
    "table": {"type": "object", "additionalProperties": false, "required": ["title", "columns", "rows"], "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 512}, "columns": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 512}}, "rows": {"type": "array", "maxItems": 100, "items": {"type": "array", "items": {"$ref": "#/$defs/value"}}}}}
  }
}
